# Temple-ERP Backend Environment Configuration Example
# Copy this file to .env and customize for your deployment environment

PROJECT_NAME="Temple ERP API"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection:
# Local SQLite (Default for desktop / development):
DATABASE_URL="sqlite:///./temple_erp.db"

# Production PostgreSQL (Optional for multi-user server deployment):
# DATABASE_URL="postgresql://temple_admin:secure_password@localhost:5432/temple_erp_db"
